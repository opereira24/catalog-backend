# Base de dados (Neon PostgreSQL)
DB_URL=jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Token partilhado com o dcbo-backend para autenticar o endpoint interno de sync (recebido) e o
# encaminhamento de leads (enviado, TASK-015) — o mesmo segredo nos dois sentidos
CATALOG_SYNC_TOKEN=

# Origem(ns) do site publico (dc) autorizada(s) a chamar /api/**, separadas por virgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL do dcbo-backend, para onde POST /api/leads encaminha cada lead (TASK-015)
DCBO_SYNC_URL=http://localhost:8080

# Numero de proxies de confianca em frente deste servico (TASK-015 review r2, IMPORTANTE 1) — o IP
# do visitante e lido a partir da DIREITA do X-Forwarded-For, contando este numero de saltos, nunca
# da esquerda (essa entrada e sempre escrita pelo proprio cliente). Default 1 = so o proxy do Render.
LEADS_RATE_LIMIT_TRUSTED_PROXY_HOPS=1

PORT=8081

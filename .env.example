# Base de dados (Neon PostgreSQL)
DB_URL=jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Token partilhado com o dcbo-backend para autenticar o endpoint interno de sync (recebido) e o
# encaminhamento de leads (enviado, TASK-015) — o mesmo segredo nos dois sentidos
CATALOG_SYNC_TOKEN=

# Origem(ns) autorizada(s) a chamar /api/** (o site publico dc e o back-office dcbo), separadas por
# virgula, sem wildcard
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth0 (TASK-002). Valores de producao (tenant oteustand):
#   AUTH0_ISSUER_URI=https://oteustand.eu.auth0.com/   (com a barra final: tem de bater certo com o
#                                                       claim "iss" que o Auth0 emite)
#   AUTH0_AUDIENCE=https://oteustand.pt/api
#   AUTH0_ROLES_CLAIM=https://oteustand.pt/roles        (e o default quando a variavel nao existe)
# Sem AUTH0_ISSUER_URI E AUTH0_AUDIENCE preenchidos, todos os endpoints protegidos respondem 401
# (os publicos continuam a funcionar). Basta faltar um dos dois para recusar tudo.
# AUTH0_ROLES_CLAIM nunca fica definida e vazia: uma variavel vazia nao cai no default do
# application.yml, e um claim vazio da zero roles a todos (403 em tudo o que exige perfil).
AUTH0_ISSUER_URI=
AUTH0_AUDIENCE=
AUTH0_ROLES_CLAIM=https://oteustand.pt/roles

# Base URL do dcbo-backend, para onde POST /api/leads encaminha cada lead (TASK-015)
DCBO_SYNC_URL=http://localhost:8080

# Numero de proxies de confianca em frente deste servico (TASK-015 review r2, IMPORTANTE 1) — o IP
# do visitante e lido a partir da DIREITA do X-Forwarded-For, contando este numero de saltos, nunca
# da esquerda (essa entrada e sempre escrita pelo proprio cliente). Default 1 = so o proxy do Render.
LEADS_RATE_LIMIT_TRUSTED_PROXY_HOPS=1

PORT=8081
